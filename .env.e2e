# E2E Test Configuration for Outline
#
# Copy this file to .env.e2e.local and fill in values for your test environment.

# Root-path deployment URL (no sub-path)
E2E_ROOT_URL=http://localhost:3000

# Sub-path deployment URL (server configured with URL=http://.../outline)
E2E_SUBPATH_URL=http://localhost:3001

# Sub-path prefix (must match the path component of SUBPATH_URL)
E2E_SUBPATH=/outline

# Keycloak OIDC admin credentials (used to log in via the OIDC flow)
E2E_ADMIN_USERNAME=
E2E_ADMIN_PASSWORD=

# OIDC provider display name on the login button (default: "OpenID Connect")
E2E_OIDC_DISPLAY_NAME=SSO
